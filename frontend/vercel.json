{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    }
  ],
  "env": {
    "NEXT_PUBLIC_CONTRACT_ADDRESS": "@contract-address",
    "NEXT_PUBLIC_RPC_ENDPOINT": "@rpc-endpoint",
    "NEXT_PUBLIC_NETWORK": "studionet",
    "API_URL": "@api-url"
  }
}
