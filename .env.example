# Deploy script (deploy/run.py) configuration.
# Copy to `.env` and fill in. See README.md.

# Network: "studionet" (https://studio.genlayer.com/api) or "localnet"
NEXT_PUBLIC_GENLAYER_NETWORK=studionet

# Override the RPC endpoint (optional)
GENLAYER_RPC_URL=https://studio.genlayer.com/api

# Funded account private key (0x-prefixed hex). If omitted the deploy
# script prints a warning and creates a throwaway account.
GENLAYER_PRIVATE_KEY=

# Address of the deployed contract (set after `python deploy/run.py deploy`)
NEXT_PUBLIC_CONTRACT_ADDRESS=